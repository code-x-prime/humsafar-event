// Humsafar Events — Prisma schema (Phase 1: full data model, no seed data yet)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  SUPPORT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum FaqScope {
  GLOBAL
  PRODUCT
  CATEGORY
}

enum SlotHoldStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

// Distinguishes a decoration booking (event date, time slot, serviceable
// city, add-ons) from a Shop With Us physical-product order (shipping
// address anywhere in India, Shiprocket fulfillment, stock deduction) inside
// the single unified Order table — the two flows share checkout/payment/
// admin plumbing but keep their own item source and delivery mechanics.
enum OrderKind {
  BOOKING
  SHOP
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum PaymentMode {
  FULL
  ADVANCE
}

enum OrderSource {
  WEB
  ADMIN_MANUAL
}

enum CouponType {
  PERCENTAGE
  FLAT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnquirySource {
  CONTACT
  POPUP
  PRODUCT
  WAITLIST
  URGENT_BOOKING
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum SettingGroup {
  GENERAL
  CONTACT
  SOCIAL
  SEO
  PAYMENT
  STORAGE
  EMAIL
  BUSINESS_RULES
  SHIPPING
}

// ─────────────────────────────────────────────────────────────
// SHOP WITH US (Shop products/reviews are their own catalog, but orders,
// carts, payments, and addresses are unified with the decoration booking
// flow below via Order.kind — see OrderKind)
// ─────────────────────────────────────────────────────────────

enum ShopShipmentMode {
  AUTO
  MANUAL
}

enum ShopShipmentStatus {
  PENDING
  AWB_ASSIGNED
  PICKUP_SCHEDULED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
  FAILED
}

enum ShopReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BannerPlacement {
  HOME_HERO
  HOME_STRIP
  CATEGORY_TOP
  OFFER_POPUP
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum OtpPurpose {
  LOGIN
  SIGNUP
  ORDER_VERIFY
  PASSWORD_RESET
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

// ─────────────────────────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String? // admins/staff only, and customers registered via email+password
  emailVerifiedAt DateTime? // set once the signup OTP is verified; null = registered but not yet confirmed
  role            Role      @default(CUSTOMER)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  auditLogs     AuditLog[]
  mediaAssets   MediaAsset[]

  shopAddresses ShopAddress[]
  shopReviews   ShopProductReview[]

  @@index([role])
}

model Otp {
  id         String     @id @default(cuid())
  phone      String?
  email      String?
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────────────────────

model Category {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  image           String?
  imageR2Key      String?
  icon            String?
  bannerDesktop   String?
  bannerMobile    String?
  metaTitle       String?
  metaDescription String?
  isActive        Boolean  @default(true)
  showInMenu      Boolean  @default(true)
  showOnHome      Boolean  @default(false)
  position        Int      @default(0)
  parentId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products ProductCategory[]

  @@index([parentId])
  @@index([position])
}

model Product {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  shortDescription String?
  description      String?
  inclusions       String[] @default([])
  exclusions       String[] @default([])
  careInfo         String[] @default([])
  deliveryInfo     String?
  setupTimeMinutes Int?
  price            Decimal  @db.Decimal(10, 2)
  mrp              Decimal? @db.Decimal(10, 2)
  discountPercent  Decimal? @db.Decimal(5, 2)
  advancePercent   Decimal? @db.Decimal(5, 2)
  advanceAmount    Decimal? @db.Decimal(10, 2)
  isCustomizable   Boolean  @default(false)
  minLeadTimeHours Int? // nullable override of global BUSINESS_RULES setting
  tags             String[] @default([])
  metaTitle        String?
  metaDescription  String?
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  position         Int      @default(0)
  avgRating        Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount      Int      @default(0)
  viewCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categories ProductCategory[]
  cities     ProductCity[]
  media      ProductMedia[]
  addOns     ProductAddOn[]
  faqItems   FaqItem[]
  variants   ProductVariant[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  sections   ProductSectionItem[]

  @@index([isActive, isFeatured])
}

// An admin-authored home page row (e.g. "Featured", "Latest", "Diwali
// Special") — its product list is curated by hand from the product form or
// the admin Sections page, independent of the category tree.
model ProductSection {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductSectionItem[]

  @@index([isActive, position])
}

model ProductSectionItem {
  productId String
  sectionId String
  position  Int    @default(0)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  section ProductSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([productId, sectionId])
  @@index([sectionId])
}

// A static promo banner row the admin can insert between ProductSection rows
// on the home page (e.g. "Corporate Event Planner — Order Now"). Shares the
// same position numbering space as ProductSection so the two interleave into
// one ordered home page feed — see getPublicHomeFeed() in section.service.js.
model HomeBanner {
  id                String   @id @default(cuid())
  desktopImage      String
  desktopImageR2Key String?
  mobileImage       String?
  mobileImageR2Key  String?
  heading           String?
  subtitle          String?
  buttonText        String?
  link              String?
  isActive          Boolean  @default(true)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive, position])
}

// A single photo in the public /gallery page (Pinterest-style masonry).
// showOnHome controls whether it also appears in a home page gallery strip —
// off by default so newly uploaded photos don't surface on the home page
// until an admin opts them in.
model GalleryImage {
  id         String   @id @default(cuid())
  image      String
  imageR2Key String?
  title      String?
  showOnHome Boolean  @default(false)
  isActive   Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, position])
  @@index([showOnHome, isActive, position])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String // e.g. "Gold · White"
  swatches  String[] @default([]) // hex colors, 1-2 shown as a split swatch dot
  position  Int      @default(0)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([productId])
}

// A reusable named set of color options (e.g. "Balloon Colors") an admin
// defines once, then attaches to any number of products — so each product's
// variant list is picked from a shared preset instead of retyped every time.
model VariantPreset {
  id        String   @id @default(cuid())
  name      String // e.g. "Balloon Colors"
  options   Json // [{ name: "Gold · White", swatches: ["#D4AF37","#FFFFFF"] }, ...]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCategory {
  productId  String
  categoryId String
  position   Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductCity {
  productId     String
  cityId        String
  priceOverride Decimal? @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  city    City    @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([productId, cityId])
  @@index([cityId])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  type      MediaType
  r2Key     String
  url       String
  alt       String?
  position  Int       @default(0)
  isPrimary Boolean   @default(false)
  width     Int?
  height    Int?
  sizeBytes Int?
  mimeType  String?
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model AddOnCategory {
  id       String @id @default(cuid())
  name     String @unique
  position Int    @default(0)

  addOns AddOn[]
}

model AddOn {
  id         String  @id @default(cuid())
  name       String
  price      Decimal @db.Decimal(10, 2)
  image      String?
  imageR2Key String?
  categoryId String?
  isActive   Boolean @default(true)
  position   Int     @default(0)

  category AddOnCategory? @relation(fields: [categoryId], references: [id])
  products ProductAddOn[]

  @@index([categoryId])
}

model ProductAddOn {
  productId String
  addOnId   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  addOn   AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([productId, addOnId])
  @@index([addOnId])
}

model FaqItem {
  id       String   @id @default(cuid())
  scope    FaqScope @default(GLOBAL)
  refId    String? // productId or categoryId depending on scope
  question String
  answer   String
  position Int      @default(0)

  product Product? @relation(fields: [refId], references: [id], onDelete: Cascade, map: "faq_item_product_fkey")

  @@index([scope, refId])
}

// ─────────────────────────────────────────────────────────────
// SERVICE AREA
// ─────────────────────────────────────────────────────────────

model City {
  id             String    @id @default(cuid())
  name           String
  state          String?
  slug           String    @unique
  region         String? // e.g. "Delhi NCR"
  isServiceable  Boolean   @default(false)
  comingSoon     Boolean   @default(true)
  position       Int       @default(0)
  deliveryCharge Decimal   @default(0) @db.Decimal(10, 2)
  minOrderValue  Decimal   @default(0) @db.Decimal(10, 2)
  lat            Decimal?  @db.Decimal(9, 6)
  lng            Decimal?  @db.Decimal(9, 6)
  deletedAt      DateTime?

  pincodes      Pincode[]
  products      ProductCity[]
  timeSlots     TimeSlot[]
  orders        Order[]
  addresses     Address[]
  banners       Banner[]
  slotBookings  SlotBooking[]
  slotHolds     SlotHold[]
  slotBlackouts SlotBlackout[]

  @@index([isServiceable])
}

model Pincode {
  id                  String    @id @default(cuid())
  code                String
  cityId              String
  isServiceable       Boolean   @default(true)
  extraDeliveryCharge Decimal   @default(0) @db.Decimal(10, 2)
  areaName            String?
  deletedAt           DateTime?

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([code, cityId])
  @@index([cityId])
}

// ─────────────────────────────────────────────────────────────
// SLOTS / AVAILABILITY
// ─────────────────────────────────────────────────────────────

model TimeSlot {
  id          String  @id @default(cuid())
  label       String
  startTime   String // "HH:mm" IST
  endTime     String
  capacity    Int     @default(1)
  surgeCharge Decimal @default(0) @db.Decimal(10, 2)
  cityId      String? // null = applies to all cities
  isActive    Boolean @default(true)
  position    Int     @default(0)

  city          City?          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  slotBlackouts SlotBlackout[]
  slotBookings  SlotBooking[]
  slotHolds     SlotHold[]

  @@index([cityId])
}

model SlotBlackout {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  timeSlotId String?
  cityId     String?
  reason     String?
  createdAt  DateTime @default(now())

  timeSlot TimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  city     City?     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([date])
}

model SlotBooking {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  timeSlotId  String
  cityId      String
  bookedCount Int      @default(0)
  updatedAt   DateTime @updatedAt

  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([date, timeSlotId, cityId])
}

model SlotHold {
  id         String         @id @default(cuid())
  orderId    String?
  date       DateTime       @db.Date
  timeSlotId String
  cityId     String
  status     SlotHoldStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime       @default(now())

  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id])

  @@index([status, expiresAt])
  @@index([date, timeSlotId, cityId])
}

// ─────────────────────────────────────────────────────────────
// MARKETING
// ─────────────────────────────────────────────────────────────

model Banner {
  id                String          @id @default(cuid())
  title             String?
  subtitle          String?
  ctaText           String?
  ctaLink           String?
  desktopImageR2Key String?
  desktopImageUrl   String?
  mobileImageR2Key  String?
  mobileImageUrl    String?
  placement         BannerPlacement
  refId             String?
  cityId            String?
  position          Int             @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  city City? @relation(fields: [cityId], references: [id])

  @@index([placement, isActive])
}

// ─────────────────────────────────────────────────────────────
// CART / CHECKOUT
// ─────────────────────────────────────────────────────────────

model Cart {
  id             String   @id @default(cuid())
  userId         String?
  guestSessionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]

  @@index([userId])
  @@index([guestSessionId])
}

// productId (-> Product) for a decoration booking line, shopProductId
// (-> ShopProduct) for a Shop With Us line — same dual-FK reasoning as
// OrderItem. variant/addOns/eventDate/timeSlot/city are booking-only.
model CartItem {
  id            String    @id @default(cuid())
  cartId        String
  productId     String?
  shopProductId String?
  variantId     String?
  addOnIds      String[]  @default([])
  eventDate     DateTime? @db.Date
  timeSlotId    String?
  cityId        String?
  notes         String?
  qty           Int       @default(1)
  createdAt     DateTime  @default(now())

  cart        Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id])
  shopProduct ShopProduct?    @relation(fields: [shopProductId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  cityId    String
  pincode   String
  lat       Decimal? @db.Decimal(9, 6)
  lng       Decimal? @db.Decimal(9, 6)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id])

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// ORDERS / PAYMENTS
// ─────────────────────────────────────────────────────────────

// Unified order table for both business lines. kind=BOOKING uses the
// decoration-specific fields (eventDate, cityId, slot/delivery/surge/coupon,
// paymentMode); kind=SHOP uses the shop-specific fields (shippingCharge,
// shipment) and ships anywhere via addressSnapshot rather than a
// serviceable-city FK. Fields only relevant to one kind are nullable/defaulted
// so a single row shape works for both without either flow seeing the other's
// concerns — services only ever read the fields for their own kind.
model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique // HE-YYYYMM-XXXXX (booking) or HS-YYYYMM-XXXXX (shop)
  kind                 OrderKind   @default(BOOKING)
  userId               String
  status               OrderStatus @default(PENDING_PAYMENT)
  // BOOKING-only
  eventDate            DateTime?   @db.Date
  timeSlotId           String?
  cityId               String?
  addOnTotal           Decimal     @default(0) @db.Decimal(10, 2)
  deliveryCharge       Decimal     @default(0) @db.Decimal(10, 2)
  surgeCharge          Decimal     @default(0) @db.Decimal(10, 2)
  couponCode           String?
  paymentMode          PaymentMode @default(FULL)
  assignedStaffId      String?
  reviewReminderSentAt DateTime?
  // SHOP-only
  shippingCharge       Decimal     @default(0) @db.Decimal(10, 2)
  // shared
  addressSnapshot      Json
  subtotal             Decimal     @db.Decimal(10, 2)
  discount             Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount            Decimal     @default(0) @db.Decimal(10, 2)
  total                Decimal     @db.Decimal(10, 2)
  amountPaid           Decimal     @default(0) @db.Decimal(10, 2)
  amountDue            Decimal     @default(0) @db.Decimal(10, 2)
  source               OrderSource @default(WEB)
  customerNote         String?
  adminNote            String?
  cancelReason         String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  city      City?         @relation(fields: [cityId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  slotHolds SlotHold[]
  shipment  ShopShipment?

  @@index([userId])
  @@index([status])
  @@index([kind])
  @@index([eventDate])
}

// productId (-> Product) is set for BOOKING items; shopProductId (-> ShopProduct)
// is set for SHOP items — exactly one of the two is non-null per row, matching
// the parent Order's kind. Kept as two nullable FKs rather than one polymorphic
// id because Product and ShopProduct are genuinely different catalogs with
// different fields; a single column can't type-safely reference either.
model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String?
  shopProductId   String?
  productSnapshot Json
  qty             Int     @default(1)
  addOnsSnapshot  Json?
  unitPrice       Decimal @db.Decimal(10, 2)
  subtotal        Decimal @db.Decimal(10, 2)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id])
  shopProduct ShopProduct? @relation(fields: [shopProductId], references: [id])

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  gateway           String        @default("razorpay")
  razorpayOrderId   String?
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(CREATED)
  method            String?
  rawPayload        Json?
  refundId          String?
  refundAmount      Decimal?      @db.Decimal(10, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// PROMOTIONS
// ─────────────────────────────────────────────────────────────

model Coupon {
  code                  String     @id
  type                  CouponType
  value                 Decimal    @db.Decimal(10, 2)
  maxDiscount           Decimal?   @db.Decimal(10, 2)
  minOrderValue         Decimal?   @db.Decimal(10, 2)
  usageLimit            Int?
  perUserLimit          Int?
  newUserOnly           Boolean    @default(false)
  minRepeatOrders       Int? // if set, customer needs at least this many completed prior orders
  usedCount             Int        @default(0)
  windowStart           DateTime?
  windowEnd             DateTime?
  applicableCategoryIds String[]   @default([])
  applicableCityIds     String[]   @default([])
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
}

// ─────────────────────────────────────────────────────────────
// REVIEWS / ENQUIRIES / CONTENT
// ─────────────────────────────────────────────────────────────

model Review {
  id         String       @id @default(cuid())
  orderId    String? // verified purchase only
  productId  String
  userId     String
  rating     Int
  title      String?
  comment    String?
  status     ReviewStatus @default(PENDING)
  adminReply String?
  isFeatured Boolean      @default(false)
  createdAt  DateTime     @default(now())

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])
  media   ReviewMedia[]

  @@index([productId, status])
}

model ReviewMedia {
  id       String    @id @default(cuid())
  reviewId String
  r2Key    String
  url      String
  type     MediaType

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String?
  eventType String?
  eventDate DateTime?     @db.Date
  city      String?
  message   String?
  source    EnquirySource @default(CONTACT)
  status    EnquiryStatus @default(NEW)
  adminNote String?
  createdAt DateTime      @default(now())

  @@index([status, source])
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  city       String?
  message    String
  image      String?
  imageR2Key String?
  rating     Decimal? @db.Decimal(2, 1) // supports half-stars, e.g. 4.5
  isActive   Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique // about, terms, privacy, refund-policy, etc.
  title           String
  content         String
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// PLATFORM
// ─────────────────────────────────────────────────────────────

model Setting {
  id       String       @id @default(cuid())
  key      String       @unique
  value    Json
  group    SettingGroup
  isSecret Boolean      @default(false)

  @@index([group])
}

model MediaAsset {
  id           String   @id @default(cuid())
  r2Key        String
  url          String
  folder       String?
  mime         String?
  size         Int?
  width        Int?
  height       Int?
  uploadedById String?
  usedInCount  Int      @default(0)
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([folder])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String?
  isRead    Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  template  String
  status    String // SENT | FAILED | RETRYING | DEAD_LETTER
  provider  String? // BREVO | SMTP
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([to])
}

// ─────────────────────────────────────────────────────────────
// SHOP WITH US — CATALOG
// ─────────────────────────────────────────────────────────────

model ShopCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  image     String?
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ShopProductCategory[]

  @@index([isActive, position])
}

model ShopProduct {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  shortDescription String?
  description      String? // rich text: full details, materials, care, etc.
  highlights       String[] @default([]) // bullet points shown near price
  price            Decimal  @db.Decimal(10, 2)
  mrp              Decimal? @db.Decimal(10, 2)
  sku              String?  @unique
  stock            Int      @default(0)
  weightGrams      Int? // used for Shiprocket rate calculation
  lengthCm         Decimal? @db.Decimal(6, 2)
  breadthCm        Decimal? @db.Decimal(6, 2)
  heightCm         Decimal? @db.Decimal(6, 2)
  shippingInfo     String? // free-text shown on the product page (e.g. "Ships in 2-3 days")
  metaTitle        String?
  metaDescription  String?
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  position         Int      @default(0)
  avgRating        Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount      Int      @default(0)
  viewCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categories ShopProductCategory[]
  media      ShopProductMedia[]
  reviews    ShopProductReview[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([isActive, isFeatured])
}

model ShopProductCategory {
  productId  String
  categoryId String
  position   Int    @default(0)

  product  ShopProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ShopCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ShopProductMedia {
  id        String    @id @default(cuid())
  productId String
  type      MediaType @default(IMAGE)
  r2Key     String
  url       String
  alt       String?
  position  Int       @default(0)
  isPrimary Boolean   @default(false)

  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ShopProductReview {
  id         String           @id @default(cuid())
  orderId    String? // verified purchase only
  productId  String
  userId     String
  rating     Int
  title      String?
  comment    String?
  status     ShopReviewStatus @default(PENDING)
  adminReply String?
  isFeatured Boolean          @default(false)
  createdAt  DateTime         @default(now())

  product ShopProduct              @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User                     @relation(fields: [userId], references: [id])
  media   ShopProductReviewMedia[]

  @@index([productId, status])
}

model ShopProductReviewMedia {
  id       String    @id @default(cuid())
  reviewId String
  r2Key    String
  url      String
  type     MediaType

  review ShopProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// SHOP WITH US — ADDRESS
// ─────────────────────────────────────────────────────────────

// India-wide shipping address for Shop With Us orders — deliberately
// separate from Address (which is scoped to Humsafar's serviceable-city
// list for the decoration business). Shop ships anywhere Shiprocket can
// reach, keyed purely by pincode, so it stores city/state as free text
// rather than a City FK.
model ShopAddress {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One shipment per order — created once the order is confirmed (paid).
// mode records whether it was pushed to Shiprocket automatically on
// confirmation or the admin created it manually later, per the global
// auto-ship setting at the time.
model ShopShipment {
  id                String             @id @default(cuid())
  orderId           String             @unique
  mode              ShopShipmentMode   @default(AUTO)
  status            ShopShipmentStatus @default(PENDING)
  shiprocketOrderId String?
  shipmentId        String? // Shiprocket's shipment_id
  awbCode           String? // airway bill / tracking number
  courierName       String?
  trackingUrl       String?
  labelUrl          String?
  manifestUrl       String?
  pickupScheduledAt DateTime?
  deliveredAt       DateTime?
  lastTrackedAt     DateTime?
  rawResponse       Json?
  error             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}
