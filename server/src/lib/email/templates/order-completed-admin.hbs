<div style="font-family: 'Jost', 'Inter', Arial, sans-serif; max-width: 480px; margin: 0 auto;">
  <div style="background: #15803D; padding: 20px 24px;">
    <span style="color: #ffffff; font-size: 18px; font-weight: 700;">Booking Completed</span>
  </div>
  <div style="padding: 24px; background: #ffffff; color: #0B1620;">
    <p style="font-size: 15px; margin: 0 0 8px;">
      <strong>{{orderNumber}}</strong> has been marked complete.
    </p>
    <p style="font-size: 14px; margin: 0 0 4px;"><strong>Customer:</strong> {{customerName}}</p>
    <p style="font-size: 14px; margin: 0;"><strong>Order value:</strong> ₹{{total}}</p>
  </div>
</div>
