<div style="font-family: 'Jost', 'Inter', Arial, sans-serif; max-width: 560px; margin: 0 auto;">
  <div style="background: #E0623D; padding: 20px 24px;">
    <span style="color: #ffffff; font-size: 18px; font-weight: 700;">New Shop Order Received</span>
  </div>
  <div style="padding: 24px; background: #ffffff; color: #0B1620;">
    <p style="font-size: 15px; margin: 0 0 16px;">
      <strong>{{orderNumber}}</strong> — ₹{{total}} paid
    </p>

    <p style="font-size: 14px; margin: 0 0 16px;"><strong>Customer:</strong> {{customerName}}{{#if customerPhone}} · {{customerPhone}}{{/if}}</p>

    <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
      {{#each items}}
      <tr>
        <td style="padding: 6px 0; border-bottom: 1px solid #EEF1F5; font-size: 13px;">{{title}} (x{{qty}})</td>
        <td style="padding: 6px 0; border-bottom: 1px solid #EEF1F5; font-size: 13px; text-align: right;">₹{{subtotal}}</td>
      </tr>
      {{/each}}
    </table>

    <p style="font-size: 13px; color: #6B7A88; margin: 0 0 4px;">Shipping Address</p>
    <p style="font-size: 14px; margin: 0 0 16px;">
      {{address.fullName}} &middot; {{address.phone}}<br />
      {{address.line1}}{{#if address.line2}}, {{address.line2}}{{/if}}<br />
      {{address.city}}, {{address.state}} — {{address.pincode}}
    </p>

    <p style="font-size: 13px; color: #6B7A88; margin: 0;">
      {{#if shipmentMode}}Shipment mode: {{shipmentMode}}{{/if}}
    </p>
  </div>
</div>
