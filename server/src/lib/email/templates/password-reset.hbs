<div style="font-family: 'Jost', 'Inter', Arial, sans-serif; max-width: 480px; margin: 0 auto;">
  <div style="background: #0E2A4D; padding: 24px; text-align: center;">
    <span style="font-family: 'Playfair Display', Georgia, serif; color: #ffffff; font-size: 22px;">
      Humsafar Events
    </span>
  </div>
  <div style="padding: 32px 24px; background: #ffffff; color: #0B1620;">
    <p style="font-size: 15px; margin: 0 0 16px;">Hi {{customerName}},</p>
    <p style="font-size: 15px; margin: 0 0 16px;">
      Your password has been reset by our support team. Your new temporary password is:
    </p>
    <p style="font-size: 24px; font-weight: 700; letter-spacing: 1px; color: #0E2A4D; margin: 0 0 16px; background: #F7F9FC; padding: 12px 16px; border-radius: 8px; text-align: center;">
      {{newPassword}}
    </p>
    <p style="font-size: 13px; color: #6B7A88; margin: 0;">
      Please log in and change this password as soon as possible. If you didn't request this, contact us immediately.
    </p>
  </div>
  <div style="background: #081C36; padding: 16px 24px; text-align: center;">
    <p style="font-size: 12px; color: #D6E0EE; margin: 0;">
      Humsafar Events &middot; Together in Every Journey
    </p>
  </div>
</div>
