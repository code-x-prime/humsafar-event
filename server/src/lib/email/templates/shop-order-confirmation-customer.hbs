<div style="font-family: 'Jost', 'Inter', Arial, sans-serif; max-width: 560px; margin: 0 auto;">
  <div style="background: #0E2A4D; padding: 24px; text-align: center;">
    <span style="font-family: 'Playfair Display', Georgia, serif; color: #ffffff; font-size: 22px;">
      Humsafar Events — Shop With Us
    </span>
  </div>
  <div style="padding: 32px 24px; background: #ffffff; color: #0B1620;">
    <p style="font-size: 16px; margin: 0 0 4px;">Hi {{customerName}},</p>
    <p style="font-size: 15px; margin: 0 0 20px;">Thanks for your order! Here are the details.</p>

    <div style="background: #F7F9FC; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
      <p style="font-size: 13px; color: #6B7A88; margin: 0 0 4px;">Order Number</p>
      <p style="font-size: 18px; font-weight: 700; color: #0E2A4D; margin: 0;">{{orderNumber}}</p>
    </div>

    <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
      {{#each items}}
      <tr>
        <td style="padding: 8px 0; border-bottom: 1px solid #EEF1F5; font-size: 14px;">
          {{title}}<br /><span style="font-size: 12px; color: #6B7A88;">Qty: {{qty}}</span>
        </td>
        <td style="padding: 8px 0; border-bottom: 1px solid #EEF1F5; font-size: 14px; text-align: right;">₹{{subtotal}}</td>
      </tr>
      {{/each}}
    </table>

    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
      <tr>
        <td style="padding: 4px 0; font-size: 13px; color: #6B7A88;">Subtotal</td>
        <td style="padding: 4px 0; font-size: 13px; color: #6B7A88; text-align: right;">₹{{subtotal}}</td>
      </tr>
      {{#if taxAmount}}
      <tr>
        <td style="padding: 4px 0; font-size: 13px; color: #6B7A88;">Tax</td>
        <td style="padding: 4px 0; font-size: 13px; color: #6B7A88; text-align: right;">₹{{taxAmount}}</td>
      </tr>
      {{/if}}
      <tr>
        <td style="padding: 4px 0; font-size: 14px; font-weight: 700;">Total Paid</td>
        <td style="padding: 4px 0; font-size: 14px; font-weight: 700; text-align: right;">₹{{total}}</td>
      </tr>
    </table>

    <div style="background: #F7F9FC; border-radius: 12px; padding: 16px;">
      <p style="font-size: 13px; color: #6B7A88; margin: 0 0 4px;">Shipping Address</p>
      <p style="font-size: 14px; margin: 0;">
        {{address.fullName}} &middot; {{address.phone}}<br />
        {{address.line1}}{{#if address.line2}}, {{address.line2}}{{/if}}<br />
        {{address.city}}, {{address.state}} — {{address.pincode}}
      </p>
    </div>

    <p style="font-size: 13px; color: #6B7A88; margin-top: 24px;">
      We'll email you tracking details as soon as your order ships.
    </p>
  </div>
  <div style="background: #081C36; padding: 16px 24px; text-align: center;">
    <p style="font-size: 12px; color: #D6E0EE; margin: 0;">
      Humsafar Events &middot; Together in Every Journey
    </p>
  </div>
</div>
