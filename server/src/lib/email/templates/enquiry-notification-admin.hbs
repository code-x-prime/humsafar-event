<div style="font-family: 'Jost', 'Inter', Arial, sans-serif; max-width: 560px; margin: 0 auto;">
  <div style="background: #0E2A4D; padding: 20px 24px;">
    <span style="color: #ffffff; font-size: 18px; font-weight: 700;">New Contact Message</span>
  </div>
  <div style="padding: 24px; background: #ffffff; color: #0B1620;">
    <p style="font-size: 14px; margin: 0 0 4px;"><strong>Name:</strong> {{name}}</p>
    <p style="font-size: 14px; margin: 0 0 4px;"><strong>Phone:</strong> {{phone}}</p>
    {{#if email}}<p style="font-size: 14px; margin: 0 0 4px;"><strong>Email:</strong> {{email}}</p>{{/if}}
    {{#if eventType}}<p style="font-size: 14px; margin: 0 0 4px;"><strong>Subject:</strong> {{eventType}}</p>{{/if}}
    {{#if city}}<p style="font-size: 14px; margin: 0 0 4px;"><strong>City:</strong> {{city}}</p>{{/if}}

    {{#if message}}
    <p style="font-size: 13px; color: #6B7A88; margin: 16px 0 4px;">Message</p>
    <p style="font-size: 14px; margin: 0; white-space: pre-wrap;">{{message}}</p>
    {{/if}}

    <p style="font-size: 12px; color: #6B7A88; margin: 20px 0 0;">Sent from the Contact Us page on humsafarevent.com.</p>
  </div>
</div>
