<div style="font-family: 'Jost', 'Inter', Arial, sans-serif; max-width: 480px; margin: 0 auto;">
  <div style="background: #E0623D; padding: 20px 24px;">
    <span style="color: #ffffff; font-size: 18px; font-weight: 700;">New Review Submitted</span>
  </div>
  <div style="padding: 24px; background: #ffffff; color: #0B1620;">
    <p style="font-size: 15px; margin: 0 0 8px;">
      <strong>{{customerName}}</strong> left a review for <strong>{{productTitle}}</strong>.
    </p>
    <p style="font-size: 15px; margin: 0 0 12px;">Rating: {{rating}} / 5</p>

    {{#if title}}
    <p style="font-size: 14px; font-weight: 600; margin: 0 0 4px;">{{title}}</p>
    {{/if}}
    {{#if comment}}
    <p style="font-size: 14px; margin: 0 0 16px; color: #3A4652;">{{comment}}</p>
    {{/if}}

    <p style="font-size: 13px; color: #6B7A88; margin: 0;">
      This review is pending — approve or reject it from the admin Reviews page.
    </p>
  </div>
</div>
