NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/humsafar_events?schema=public

# JWT
ACCESS_JWT_SECRET=
ACCESS_TOKEN_LIFE=7d

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_LIFE=7d

ADMIN_JWT_SECRET=
ADMIN_TOKEN_LIFE=12h

# Secret encryption (Setting.isSecret, AES-256-GCM) — 32-byte hex string
ENCRYPTION_KEY=

# CORS
CLIENT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173

# NOTE: R2, Razorpay, SMTP, and Brevo credentials are NOT read from env.
# They are stored encrypted in the Setting table (group EMAIL/PAYMENT/STORAGE)
# and loaded at boot by src/config/settings.service.js.
